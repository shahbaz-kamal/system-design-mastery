digraph G { rankdir=LR; bgcolor="white"; graph [pad="0.25",nodesep="0.4",ranksep="0.5"]; node [shape=box,style="rounded,filled",fillcolor="#EAF2F8",color="#255774",fontname="Calibri",fontsize=12,margin="0.15"]; edge [fontname="Calibri",fontsize=10,color="#45677A"]; client -> network [label="transit"]; network -> queue [label="wait for resource"]; queue -> processing [label="service time"]; processing -> client [label="response"]; client -> queue [label="retry adds work",color="#B34B42",style=dashed]; }